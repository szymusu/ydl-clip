{
    "name": "szymusu/ydl-clip",
    "description": "PHP composer package for downloading parts of videos from youtube",
    "type": "library",
    "license": "MIT",
    "scripts": {
        "test": "php vendor/phpunit/phpunit/phpunit --testdox test",
        "test-no-network": "php vendor/phpunit/phpunit/phpunit --testdox test --exclude-group network",
        "build": "$(composer global config bin-dir --absolute)/box compile"
    },
    "authors": [
        {
            "name": "szymusu",
            "email": "szymusu@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {"szymusu\\YdlClip\\": "src/"}
    },
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "james-heinrich/getid3": "^1.9"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.5.0"
    }
}
