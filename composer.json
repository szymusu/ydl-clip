{
    "name": "szymusu/ydl-clip",
    "description": "PHP composer package for downloading parts of videos from youtube",
    "type": "library",
    "license": "MIT",
    "scripts": {
        "test": "php vendor/phpunit/phpunit/phpunit test --exclude-group download",
        "build": "/home/_m/.config/composer/vendor/bin/box compile"
    },
    "authors": [
        {
            "name": "szymusu",
            "email": "szymusu@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {"szymusu\\YdlClip\\": "src/"}
    },
    "require": {
        "php": ">=8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.5.0"
    }
}
